{
  "name": "@edgeai/dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash ../scripts/dev/dev-kestra-native.sh",
    "build": "bash ../scripts/ops/build-kestra-console.sh",
    "start": "bash ../scripts/ops/start-kestra-console.sh",
    "typecheck": "bash ../scripts/dev/prepare-kestra-native.sh && ../output/kestra-native/upstream/ui/node_modules/.bin/vue-tsc --project kestra-native/tsconfig.json --noEmit",
    "lint": "bash ../scripts/dev/prepare-kestra-native.sh && ../output/kestra-native/upstream/ui/node_modules/.bin/eslint kestra-native tests lib",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/*.unit.mjs tests/*.unit.ts",
    "test:integration": "playwright test --config playwright.profiles.config.ts"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "js-yaml": "4.3.2",
    "lossless-json": "4.3.1",
    "vue": "3.5.30",
    "vue-material-design-icons": "5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  }
}
