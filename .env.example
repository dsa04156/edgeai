# Local development only. scripts/dev/bootstrap.sh generates independent random passwords.
EDGEAI_API_PORT=18080
# Optional second, native HTTPS connector for authenticated Device/Runner clients.
# Uses the same bind address and authentication rules as the primary API connector.
EDGEAI_API_TLS_ENABLED=false
EDGEAI_API_TLS_PORT=18443
# Absolute PEM certificate (leaf + intermediates) and unencrypted private key files.
# Mount private key material only in the API container; never commit it.
# EDGEAI_API_TLS_CERTIFICATE_FILE=/path/to/api-fullchain.pem
# EDGEAI_API_TLS_PRIVATE_KEY_FILE=/path/to/private/api.key
# Containers/Kubernetes set EDGEAI_BIND_ADDRESS=0.0.0.0 and EDGEAI_DB_HOST to the DB service.
# Dashboard can set EDGEAI_API_BASE_URL=http://edgeai-api:18080 (server-side only).
EDGEAI_DASHBOARD_PORT=13080
EDGEAI_API_USER=edgeai
EDGEAI_API_PASSWORD=GENERATE_WITH_BOOTSTRAP
EDGEAI_DB_PORT=15432
EDGEAI_DB_NAME=edgeai
EDGEAI_DB_USER=edgeai
EDGEAI_DB_PASSWORD=GENERATE_WITH_BOOTSTRAP
# Restored databases require explicit read-only inspection with all execution/inventory flags disabled.
# This never activates recovered workers. See docs/operations/recovery/recovery-inspection.md.
EDGEAI_RECOVERY_INSPECT_ONLY=false
EDGEAI_MQTT_PORT=11883
EDGEAI_MINIO_PORT=19000
EDGEAI_MINIO_CONSOLE_PORT=19001
EDGEAI_MINIO_USER=edgeai
EDGEAI_MINIO_PASSWORD=GENERATE_WITH_BOOTSTRAP
# Optional real node inventory. Disabled locally unless explicitly configured.
EDGEAI_KUBE_ENABLED=false
# Read-only server/device classification. Sensors come from EdgeX, not KubeEdge CRDs.
# dev-backend.sh selects api when KUBE_ENABLED, otherwise kubectl with a fixed current context.
# EDGEAI_INFRASTRUCTURE_SOURCE=disabled
# EDGEAI_INFRASTRUCTURE_CONTEXT=your-cluster-context
# dev-backend.sh discovers the existing EdgeX metadata Service in the fixed local context.
# EDGEAI_EDGEX_ENABLED=true
# EDGEAI_EDGEX_METADATA_URL=http://edgex-core-metadata.edgex-system.svc:59881
# EDGEAI_EDGEX_DATA_URL=http://edgex-core-data.edgex-system.svc:59880
# EDGEAI_EDGEX_COMMAND_URL=http://edgex-core-command.edgex-system.svc:59882
# In Kubernetes, the deployment uses its own service account and CA file.
# EDGEAI_KUBE_API_URL=https://kubernetes.default.svc
# EDGEAI_KUBE_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
# EDGEAI_KUBE_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
# Actual Job execution is opt-in until runtime bootstrap and versioned storage are ready.
EDGEAI_RUNTIME_ENABLED=false
# M6 idle lifecycle only; keep disabled until public lifecycle + VD Task execution are connected.
EDGEAI_VD_ENABLED=false
# EDGEAI_RUNTIME_NAMESPACE=edgeai-runtimes
# EDGEAI_RUNTIME_SERVICE_ACCOUNT=edgeai-runner
# EDGEAI_RUNTIME_CONTROL_PLANE_URL=http://edgeai-api.edgeai.svc:18080
# Optional deployment-owned ConfigMap in the runtime namespace, containing public CA bundle key ca.crt.
# EDGEAI_RUNTIME_CA_CONFIG_MAP=edgeai-runtime-ca-v1
# EDGEAI_RUNNER_KEY_FILE=/path/to/private/runner-signing.key
# Signing key: exactly 32 random bytes encoded as 64 hex characters; retain across API restarts.
# EDGEAI_RUNTIME_DISPATCH_SECONDS=120
# EDGEAI_STORAGE_URL=http://127.0.0.1:19000
# EDGEAI_STORAGE_RUNNER_URL=http://edgeai-minio.edgeai.svc:9000
# EDGEAI_ARTIFACT_BUCKET=edgeai-artifacts
# Optional Remote reference protocol. Requires runtime + versioned storage above.
EDGEAI_REMOTE_ENABLED=false
# EDGEAI_REMOTE_PROVIDER_KEY=reference
# EDGEAI_REMOTE_URL=https://remote.example.test
# EDGEAI_REMOTE_TOKEN_FILE=/path/to/private/remote-bearer
# EDGEAI_REMOTE_CA_FILE=/path/to/private/remote-ca.pem
# EDGEAI_REMOTE_SOURCE_MODE=SYNTHETIC
# EDGEAI_REMOTE_TIMEOUT_SECONDS=10
# Only literal loopback HTTP is accepted for a local synthetic provider. Never commit bearer files.
# Provider origin/protocol/CA/sourceMode are pinned per Run/Attempt; restore the original settings to resume old work.
# Optional stream authority worker. This does not enable public STREAM execution.
EDGEAI_STREAM_ENABLED=false
# Authenticated binding/token APIs are a separate opt-in until SDK and public STREAM execution are connected.
EDGEAI_STREAM_BINDINGS_ENABLED=false
# Public AUTO/NODE stream Runs require runtime + authority + bindings and an operational TLS broker.
# Keep disabled until those endpoints and client trust are configured and verified.
EDGEAI_STREAM_RUNS_ENABLED=false
EDGEAI_STREAM_LEASE_SECONDS=30
# EDGEAI_STREAM_DEVICE_KEY_FILE=/path/to/private/device-stream-signing.key
# Use a separate random 32-byte key, 64 lowercase hex characters, owner-only ordinary file.
# Optional client-facing address of the SAME broker (defaults to EDGEAI_STREAM_BROKER_URL).
# EDGEAI_STREAM_CLIENT_URL=ssl://broker.example.test:8883
# Dedicated Mosquitto dynamic-security broker: all four default ACL actions must deny.
# EDGEAI_STREAM_BROKER_URL=ssl://broker.example.test:8883
# EDGEAI_STREAM_BROKER_DIGEST=sha256:<64 lowercase hex characters for the pinned broker configuration>
# EDGEAI_STREAM_ADMIN_USER=edgeai-admin
# EDGEAI_STREAM_ADMIN_PASSWORD_FILE=/path/to/private/mqtt-admin-password
# EDGEAI_STREAM_CA_FILE=/path/to/broker-ca.pem
# EDGEAI_STREAM_PRINCIPAL_KEY_FILE=/path/to/private/mqtt-principal-key
# Password/key files must be ordinary non-symlink owner-only files (0400/0600).
# Principal key: 32 random bytes encoded as exactly 64 lowercase hex characters, no newline.
# Retain broker configuration/digest and key across restarts; do not point an old digest at a new broker.

# Partner canvas integration; set false in both API and Dashboard to hide workflows.
EDGEAI_WORKFLOW_ENABLED=true

# Original Platform-Service: Dashboard -> FastAPI -> Buildx/Gitea/Argo CD.
# Server-only; the same random token is loaded by Dashboard and FastAPI.
EDGEAI_PLATFORM_SERVICE_URL=http://127.0.0.1:18081
# EDGEAI_PLATFORM_SERVICE_TOKEN=GENERATE_A_RANDOM_TOKEN
# PLATFORM_GITEA_URL=http://192.168.0.56:5200
# PLATFORM_GITEA_TOKEN=YOUR_EXISTING_GITEA_TOKEN
# PLATFORM_GITEA_OWNER=etri
# PLATFORM_GITEA_REPO=test
PLATFORM_GITEA_BRANCH=main
# PLATFORM_ARGOCD_URL=http://argocd.192.168.0.56.sslip.io
# Use a token OR a username/password; do not expose them through NEXT_PUBLIC_*.
# PLATFORM_ARGOCD_TOKEN=YOUR_EXISTING_ARGOCD_TOKEN
# PLATFORM_ARGOCD_USER=YOUR_ARGOCD_USER
# PLATFORM_ARGOCD_PASSWORD=YOUR_ARGOCD_PASSWORD
PLATFORM_ARGOCD_PROJECT=default
PLATFORM_ARGOCD_NAMESPACE=default
# PLATFORM_CA_FILE=/path/to/internal-ca.pem
# PLATFORM_WORKSPACE=/absolute/private/writable/platform-service-workspace
# PLATFORM_BUILD_CONTEXT=/absolute/path/to/edgeai/platform-service/dds-k8s-project
# PLATFORM_IMAGE_REPOSITORY=192.168.0.56:5000/fastdds-unified
PLATFORM_BUILD_PLATFORMS=linux/arm64
# Existing Buildx builder with registry access; no builder is created automatically.
# PLATFORM_BUILDX_BUILDER=YOUR_EXISTING_BUILDER

# Existing Prometheus (server-side only). No new collector is installed.
EDGEAI_PROMETHEUS_ENABLED=false
EDGEAI_PROMETHEUS_URL=http://prometheus-kube-prometheus-prometheus.kube-system.svc:9090
