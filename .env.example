# Local development only. scripts/bootstrap.sh generates independent random passwords.
EDGEAI_API_PORT=18080
# Containers/Kubernetes set EDGEAI_BIND_ADDRESS=0.0.0.0 and EDGEAI_DB_HOST to the DB service.
# Dashboard can set EDGEAI_API_BASE_URL=http://edgeai-api:18080 (server-side only).
EDGEAI_DASHBOARD_PORT=13080
EDGEAI_API_USER=edgeai
EDGEAI_API_PASSWORD=GENERATE_WITH_BOOTSTRAP
EDGEAI_DB_PORT=15432
EDGEAI_DB_NAME=edgeai
EDGEAI_DB_USER=edgeai
EDGEAI_DB_PASSWORD=GENERATE_WITH_BOOTSTRAP
EDGEAI_MQTT_PORT=11883
EDGEAI_MINIO_PORT=19000
EDGEAI_MINIO_CONSOLE_PORT=19001
EDGEAI_MINIO_USER=edgeai
EDGEAI_MINIO_PASSWORD=GENERATE_WITH_BOOTSTRAP
# Optional real node inventory. Disabled locally unless explicitly configured.
EDGEAI_KUBE_ENABLED=false
# In Kubernetes, the deployment uses its own service account and CA file.
# EDGEAI_KUBE_API_URL=https://kubernetes.default.svc
# EDGEAI_KUBE_TOKEN_FILE=/var/run/secrets/kubernetes.io/serviceaccount/token
# EDGEAI_KUBE_CA_FILE=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
