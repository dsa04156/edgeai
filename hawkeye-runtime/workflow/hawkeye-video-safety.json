        "platform": {"os": "linux", "architectures": ["amd64"]},
        "inputs": {"frames": {"mediaType": "application/x-tar", "maxBytes": 16777216, "required": true}},
        "outputs": {"detections": {"mediaType": "application/json", "maxBytes": 1048576}},
