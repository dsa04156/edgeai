        "apiVersion": "edgeai/v1",
        "image": "10.254.192.47:5000/edgeai/hawkeye-workflow@sha256:4c94d2b934bb06e7263d8786bc5e3595fe4eb7c34d78a274188c659ba27e2520",
        "command": ["python3", "/opt/edgeai/hawkeye/hawkeye_infer.py"],
        "args": [],
