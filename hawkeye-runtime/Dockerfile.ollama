# linux/amd64. Official Ollama with the Hawkeye model store baked in (no download at start).
# The store is the OLLAMA_MODELS directory produced by `build.sh prepare`; the runtime adapter re-checks the blob digests.
FROM docker.io/ollama/ollama:0.32.5@sha256:4dea9fb511947e24a84237bb636b0203abcb2ff0d3fbc7b4ff865deb91362131
LABEL org.opencontainers.image.source=https://github.com/dsa04156/edgeai
COPY models /opt/hawkeye/models
# Loopback only: the adapter in the same Pod is the sole client. No cloud models, the model stays loaded.
ENV OLLAMA_MODELS=/opt/hawkeye/models OLLAMA_HOST=127.0.0.1:11434 OLLAMA_NO_CLOUD=1 OLLAMA_KEEP_ALIVE=-1 \
    OLLAMA_NUM_PARALLEL=1 HOME=/tmp
USER 10001:10001
