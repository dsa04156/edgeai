{
  "name": "arduino-001",
  "kind": "physical",
  "protocol": "serial-json",
  "targetNode": "etri-dev0001-jetorn",
  "collectionInterval": 1000,
  "protocolConfig": {
    "devicePath": "/dev/edgeai/arduino-001",
    "deviceId": "arduino-001",
    "baudRate": 115200,
    "timeoutMs": 4000
  },
  "properties": [
    {
      "name": "temperature_raw",
      "sensor": "temperature",
      "jsonPath": "raw",
