      "unit": "raw",
      "scale": 1,
      "offset": 0
    },
    {
      "name": "light_raw",
      "sensor": "light",
      "jsonPath": "value",
      "dataType": "int32",
      "unit": "raw",
      "scale": 1,
      "offset": 0
    },
    {
      "name": "magnetic_raw",
      "sensor": "magnetic",
      "jsonPath": "value",
      "dataType": "int32",
      "unit": "raw",
      "scale": 1,
      "offset": 0
    },
    {
      "name": "acceleration_x_raw",
      "sensor": "acceleration",
      "jsonPath": "x",
      "dataType": "int32",
      "unit": "raw",
      "scale": 1,
      "offset": 0
    },
    {
      "name": "acceleration_y_raw",
      "sensor": "acceleration",
      "jsonPath": "y",
      "dataType": "int32",
      "unit": "raw",
      "scale": 1,
      "offset": 0
    },
    {
      "name": "acceleration_z_raw",
      "sensor": "acceleration",
      "jsonPath": "z",
