{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "edgeai-devices",
        "labels": {
          "app.kubernetes.io/part-of": "edgeai",
          "app.kubernetes.io/managed-by": "edgeai-bootstrap"
        }
      }
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "Role",
      "metadata": {
        "name": "edgeai-device-manager",
        "namespace": "edgeai-devices",
        "labels": {
          "app.kubernetes.io/part-of": "edgeai",
          "app.kubernetes.io/managed-by": "edgeai-bootstrap"
        }
      },
      "rules": [
        {
          "apiGroups": [
            "devices.kubeedge.io"
          ],
          "resources": [
            "devices",
            "devicemodels"
          ],
          "verbs": [
            "get",
            "list",
            "create",
            "update",
            "delete"
          ]
        },
        {
          "apiGroups": [
            "devices.kubeedge.io"
          ],
          "resources": [
            "devicestatuses"
          ],
          "verbs": [
            "get",
            "list"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "configmaps"
          ],
          "verbs": [
            "get",
            "list",
            "create",
            "update",
            "delete"
          ]
        },
        {
          "apiGroups": [
            "apps"
          ],
          "resources": [
            "deployments"
          ],
          "verbs": [
            "get",
            "list",
            "create",
            "update",
            "delete"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
        "name": "edgeai-device-manager",
        "namespace": "edgeai-devices",
        "labels": {
          "app.kubernetes.io/part-of": "edgeai",
          "app.kubernetes.io/managed-by": "edgeai-bootstrap"
        }
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "Role",
        "name": "edgeai-device-manager"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "edgeai-control-plane",
          "namespace": "edgeai"
        }
      ]
    }
  ]
}
