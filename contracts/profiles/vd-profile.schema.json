{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EdgeAI VD Profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "type",
    "serviceProfileVersionId",
    "sources",
    "state",
    "runtime"
  ],
  "properties": {
    "apiVersion": {
      "const": "edgeai.vd/v2"
    },
    "type": {
      "enum": [
        "sensorMirror",
        "processing",
        "emulation"
      ]
    },
    "serviceProfileVersionId": {
      "type": "string",
      "format": "uuid"
    },
    "sources": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "maxLength": 100,
        "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deviceModel",
          "required"
        ],
        "properties": {
          "deviceModel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "const": "STATELESS"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxConcurrentTasks",
        "startupTimeoutSeconds",
        "drainTimeoutSeconds"
      ],
      "properties": {
        "maxConcurrentTasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "startupTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "drainTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "sampleCount",
        "outputPort",
        "pipelines"
      ],
      "properties": {
        "apiVersion": {
          "const": "edgeai.processing/v1"
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "outputPort": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 63
        },
        "pipelines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "input",
              "steps"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "maxLength": 63
              },
              "input": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sourceKey",
                      "property"
                    ],
                    "properties": {
                      "sourceKey": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "property": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$",
                        "maxLength": 63
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "port",
                      "output"
                    ],
                    "properties": {
                      "port": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$",
                        "maxLength": 63
                      },
                      "output": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$",
                        "maxLength": 63
                      }
                    }
                  }
                ]
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "op",
                        "mode",
                        "alpha"
                      ],
                      "properties": {
                        "op": {
                          "const": "filter"
                        },
                        "mode": {
                          "enum": [
                            "lowPass",
                            "highPass"
                          ]
                        },
                        "alpha": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 1
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "op",
                        "window"
                      ],
                      "properties": {
                        "op": {
                          "enum": [
                            "movingAverage",
                            "rms"
                          ]
                        },
                        "window": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1024
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "op",
                        "sampleRateHz"
                      ],
                      "properties": {
                        "op": {
                          "const": "fft"
                        },
                        "sampleRateHz": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 1000000
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "op",
                        "operator",
                        "value"
                      ],
                      "properties": {
                        "op": {
                          "const": "threshold"
                        },
                        "operator": {
                          "enum": [
                            "gt",
                            "gte",
                            "lt",
                            "lte",
                            "eq"
                          ]
                        },
                        "value": {
                          "type": "number"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "description": "Mapper 센서 측정값 또는 다른 VD의 BATCH 결과를 공통 처리합니다. 의미 검증(원본 키, 중복 결과 이름, 단계 순서, 표본 창)은 서버가 수행합니다.",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "sensorMirror",
              "processing"
            ]
          }
        },
        "not": {
          "required": [
            "processing"
          ]
        }
      },
      "then": {
        "properties": {
          "sources": {
            "minProperties": 1,
            "not": {
              "additionalProperties": {
                "properties": {
                  "required": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "processing"
        ]
      },
      "then": {
        "properties": {
          "type": {
            "const": "processing"
          },
          "sources": {
            "anyOf": [
              {
                "maxProperties": 0
              },
              {
                "minProperties": 1,
                "not": {
                  "additionalProperties": {
                    "properties": {
                      "required": {
                        "const": false
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
