{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgeai:stream-execution-control:v1",
  "title": "Runner stream execution owner protocol",
  "description": "Runner consumer contract; server orchestration endpoints are pending and public STREAM remains disabled. READY mappings must cover exactly the immutable SERVICE stream ports, all generation IDs must be unique, at most 16 output routes and 32 total routes. A durable completion grant is bound to the exact current terminal checkpoint and must remain readable if component peers have already finalized. This document does not claim server implementation.",
  "$defs": {
    "executionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "podUid": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "epoch",
        "podUid"
      ]
    },
    "executionResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "WAITING"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "READY"
            },
            "runId": {
              "type": "string",
              "format": "uuid"
            },
            "taskId": {
              "type": "string",
              "format": "uuid"
            },
            "attemptId": {
              "type": "string",
              "format": "uuid"
            },
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "inputs": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 16,
              "propertyNames": {
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$"
              },
              "additionalProperties": {
                "type": "string",
                "format": "uuid"
              }
            },
            "outputs": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$"
              },
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "recovery": {
              "enum": [
                "NEW",
                "RESTORE",
                "HANDOVER"
              ]
            }
          },
          "required": [
            "state",
            "runId",
            "taskId",
            "attemptId",
            "epoch",
            "inputs",
            "outputs",
            "recovery"
          ]
        }
      ]
    },
    "completeRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "podUid": {
          "type": "string",
          "format": "uuid"
        },
        "checkpointId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "epoch",
        "podUid",
        "checkpointId"
      ]
    },
    "completeResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "WAITING",
            "FINALIZE"
          ]
        },
        "checkpointId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "state",
        "checkpointId"
      ]
    }
  }
}
