{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:edgeai:stream-execution-control:v1",
  "title": "Runner stream execution owner protocol",
  "description": "Internal Runner and Device execution assignment/completion protocol. Server component implementation freezes complete route membership and grants connected components atomically after matching terminal checkpoint cursors and Device processing acknowledgements. Public STREAM Run creation remains disabled until provisioning, SDK ownership, recovery and Kubernetes acceptance are integrated. READY covers immutable SERVICE stream ports, with unique generation IDs, at most 16 output routes and 32 total routes. Grants are bound to the exact terminal checkpoint and survive peer finalization.",
  "$defs": {
    "executionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "podUid": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "epoch",
        "podUid"
      ]
    },
    "executionResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "WAITING"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "READY"
            },
            "runId": {
              "type": "string",
              "format": "uuid"
            },
            "taskId": {
              "type": "string",
              "format": "uuid"
            },
            "attemptId": {
              "type": "string",
              "format": "uuid"
            },
            "epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "inputs": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 16,
              "propertyNames": {
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$"
              },
              "additionalProperties": {
                "type": "string",
                "format": "uuid"
              }
            },
            "outputs": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "maxLength": 100,
                "pattern": "^[a-z][a-z0-9]*([._-][a-z0-9]+)*$"
              },
              "additionalProperties": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "recovery": {
              "enum": [
                "NEW",
                "RESTORE",
                "HANDOVER"
              ]
            }
          },
          "required": [
            "state",
            "runId",
            "taskId",
            "attemptId",
            "epoch",
            "inputs",
            "outputs",
            "recovery"
          ]
        }
      ]
    },
    "completeRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "podUid": {
          "type": "string",
          "format": "uuid"
        },
        "checkpointId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "epoch",
        "podUid",
        "checkpointId"
      ]
    },
    "completeResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "WAITING",
            "FINALIZE"
          ]
        },
        "checkpointId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "state",
        "checkpointId"
      ]
    },
    "deviceCompleteRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "generationId": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "epoch",
        "generationId",
        "sequence"
      ]
    },
    "deviceCompleteResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "WAITING",
            "FINALIZE"
          ]
        },
        "generationId": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "state",
        "generationId",
        "sequence"
      ]
    }
  }
}
