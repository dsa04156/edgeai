{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgeai.example/contracts/streams/checkpoint-v1",
  "title": "Portable stream checkpoint",
  "description": "Canonical ASCII JSON, maximum 72 MiB. Runtime additionally validates exact bindings, serial/revision order, contiguous pending frames, END positions, canonical base64 and per-route byte/count budgets. Storage authenticity and restore authority are separate.",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "serial", "revision", "stateBase64", "executionSha256", "manifest", "routes"],
  "properties": {
    "apiVersion": {"const": "edgeai.stream-checkpoint/v1"},
    "serial": {"$ref": "#/$defs/counter"},
    "revision": {"$ref": "#/$defs/counter"},
    "stateBase64": {"type": "string", "maxLength": 1398104, "pattern": "^[A-Za-z0-9+/]*={0,2}$"},
    "executionSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest": {
      "type": "object", "additionalProperties": false, "required": ["version", "inputs", "outputs", "limits"],
      "properties": {
        "version": {"const": 1},
        "inputs": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/binding"}},
        "outputs": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/binding"}},
        "limits": {
          "type": "object", "additionalProperties": false, "required": ["max_frames", "max_buffer_bytes", "max_state_bytes"],
          "properties": {
            "max_frames": {"type": "integer", "minimum": 1, "maximum": 4096},
            "max_buffer_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
            "max_state_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
          }
        }
      }
    },
    "routes": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["routeId", "received", "committed", "ended", "frames"],
        "properties": {
          "routeId": {"$ref": "frame.schema.json#/$defs/uuid"},
          "received": {"$ref": "#/$defs/counter"}, "committed": {"$ref": "#/$defs/counter"},
          "ended": {"type": "boolean"},
          "frames": {"type": "array", "maxItems": 4096, "items": {"$ref": "frame.schema.json"}}
        }
      }
    }
  },
  "$defs": {
    "counter": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["routeId", "generation", "producer"],
      "properties": {
        "routeId": {"$ref": "frame.schema.json#/$defs/uuid"}, "generation": {"$ref": "frame.schema.json#/$defs/counter"},
        "producer": {"oneOf": [{"$ref": "frame.schema.json#/$defs/deviceSession"}, {"$ref": "frame.schema.json#/$defs/taskAttempt"}]}
      }
    }
  }
}
